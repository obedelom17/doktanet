{
  "name": "doktanet-api",
  "private": true,
  "version": "0.1.0",
  "dependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.2",
    "@neondatabase/serverless": "^1.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "wrangler": "^3.90.0"
  },
  "scripts": {
    "build": "flutter build web --release",
    "check:api": "node --check functions/api/[[path]].js && node --check functions/_shared/util.js",
    "db:setup": "node db-setup.mjs",
    "db:seed": "node db-setup.mjs seed",
    "db:migrate": "node db-setup.mjs migration_v2",
    "db:schema": "node db-setup.mjs schema",
    "env:sync": "node sync-env.mjs",
    "dev": "node sync-env.mjs && flutter build web && wrangler pages dev build/web",
    "test": "node --import ./tests/register.mjs --test tests/util.test.mjs tests/api.test.mjs"
  },
  "type": "module"
}
